generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum HealthStatus {
  HEALTHY
  SUSPECT
  DEAD
}

enum ModerationStatus {
  APPROVED
  FLAGGED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VoteValue {
  UP
  DOWN
}

enum ReportReason {
  DEAD
  INAPPROPRIATE
}

model Category {
  id               String                  @id @default(uuid())
  slug             String                  @unique
  label            String
  description      String
  accent           String
  sortOrder        Int                     @default(0)
  destinations     Destination[]
  submissions      DestinationSubmission[]
  weightMultiplier Float                   @default(1)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
}

model Destination {
  id                  String                 @id @default(uuid())
  url                 String                 @unique
  title               String
  description         String
  tags                String[]
  categoryId          String
  category            Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  healthStatus        HealthStatus           @default(HEALTHY)
  moderationStatus    ModerationStatus       @default(APPROVED)
  isNsfw              Boolean                @default(false)
  clickCount          Int                    @default(0)
  upvotes             Int                    @default(0)
  downvotes           Int                    @default(0)
  reportCount         Int                    @default(0)
  editorialScore      Int                    @default(3)
  weirdness           Int                    @default(3)
  rankingBoost        Float                  @default(1)
  consecutiveFailures Int                    @default(0)
  lastHttpStatus      Int?
  lastFailureReason   String?
  lastCheckedAt       DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  votes               DestinationVote[]
  reports             DestinationReport[]
  submission          DestinationSubmission?

  @@index([categoryId, healthStatus, moderationStatus, isNsfw])
  @@index([lastCheckedAt])
  @@index([reportCount])
}

model RankingConfig {
  id              String   @id @default("default")
  baseWeight      Float    @default(1)
  editorialWeight Float    @default(0.22)
  weirdnessWeight Float    @default(0.10)
  voteWeight      Float    @default(1)
  voteCap         Float    @default(0.75)
  reportPenalty   Float    @default(0.20)
  minWeight       Float    @default(0.10)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AdminUser {
  id                  String                  @id @default(uuid())
  email               String                  @unique
  passwordHash        String
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  sessions            AdminSession[]
  reviewedSubmissions DestinationSubmission[] @relation("SubmissionReviewer")
}

model AdminSession {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([adminId, expiresAt])
  @@index([expiresAt])
}

model DestinationSubmission {
  id             String           @id @default(uuid())
  url            String
  title          String
  description    String
  tags           String[]
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  contactEmail   String?
  isNsfw         Boolean          @default(false)
  status         SubmissionStatus @default(PENDING)
  moderationNote String?
  destinationId  String?          @unique
  destination    Destination?     @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  reviewedById   String?
  reviewedBy     AdminUser?       @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([url])
}

model DestinationVote {
  id            String      @id @default(uuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  sessionHash   String
  value         VoteValue
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([destinationId, sessionHash])
  @@index([sessionHash])
}

model DestinationReport {
  id            String       @id @default(uuid())
  destinationId String
  destination   Destination  @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  sessionHash   String
  reason        ReportReason
  createdAt     DateTime     @default(now())

  @@unique([destinationId, sessionHash])
  @@index([sessionHash])
}
