DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
SESSION_HASH_SECRET="replace-with-a-long-random-secret"
CRON_SECRET="replace-with-a-long-random-secret"
DATABASE_POOL_MAX="5"
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX" # Optional GA4 visit tracking

# Bootstrap the owner account once with `npm run admin:bootstrap`.
# Remove ADMIN_PASSWORD from deployment environment after bootstrapping.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="replace-with-a-long-random-password"
